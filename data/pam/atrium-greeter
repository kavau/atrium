# /etc/pam.d/atrium-greeter
#
# SHORTCUT: auth and account use pam_permit.so (accept everything).
# Replace with pam_unix.so or equivalent when the greeter handles credentials.

auth     sufficient  pam_permit.so
account  sufficient  pam_permit.so
password required    pam_deny.so
session  required    pam_env.so envfile=/etc/locale.conf
session  required    pam_systemd.so
